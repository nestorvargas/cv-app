# Copy to .env.prod on the server (gitignored) and set real values.
DB_PASSWORD=change-me
# First admin, created only while the users table is empty. Min 8 chars.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# AI assistant (optional). Defaults to Ollama on the host
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:3b
# Google sign-in (optional): OAuth 2.0 web client ID
# GOOGLE_CLIENT_ID=
