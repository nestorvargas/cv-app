DATABASE_URL=postgresql://cv_user:cv_password@localhost:5432/cv_db
PORT=3001
NODE_ENV=development

# Initial admin user, created only when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# true when served over HTTPS (production)
COOKIE_SECURE=false
# Proxy hops in front of the backend, for real client IPs (e.g. 2 behind cloudflared + nginx)
# TRUST_PROXY=2
